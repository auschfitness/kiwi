VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The public half of a VAPID key pair. Only needed for reminders that reach
# her phone while the app is closed (see "Phone reminders" in the README).
# Leave it empty and the app behaves exactly as it does without it: the
# reminder inside the app still works, Settings says plainly that phone
# reminders aren't set up, and nothing is ever attempted in the background.
#
# Generate the pair once with `npx web-push generate-vapid-keys`. The PUBLIC
# key goes here — it ships inside the app, like the anon key above, and is
# meant to be public. The PRIVATE key goes into the Supabase Edge Function's
# secrets and nowhere else: never in this file, never in git.
VITE_VAPID_PUBLIC_KEY=

# Only needed to re-download the card photographs (`npm run photos`).
# Not needed to run, build or deploy the app — the photos are committed.
# Free key from https://www.pexels.com/api/. Put the real value in
# .env.local, which is gitignored; never commit it.
PEXELS_API_KEY=
